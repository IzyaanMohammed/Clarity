OPENROUTER_API_KEY=your_key_here
CLARITY_ENV=development
CLARITY_LOG_LEVEL=INFO
CLARITY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLARITY_APP_BASE_URL=http://localhost:5173
CLARITY_DB_PATH=clarity.db
CLARITY_ENFORCE_RATE_LIMITS=0
MAX_FREE_QUESTIONS_PER_DAY=10
MAX_FREE_UPLOADS_PER_DAY=2
RESEND_API_KEY=your_resend_key_here
PARENT_REPORT_FROM_EMAIL=noreply@resend.dev
CLARITY_WORKSHEET_FEEDS=https://r.jina.ai/http://cbseacademic.nic.in/
CLARITY_KHAN_WORKSHEET_API=/api/khan-adapter
CLARITY_ENABLE_KHAN_ADAPTER_MOCK=0
CLARITY_WORKSHEET_BOARD=CBSE
CLARITY_ALLOW_ALL_BOARDS=0
CLARITY_WORKSHEET_CACHE_TTL_SECONDS=900
CLARITY_WORKSHEET_LOCAL_JSON=data/cbse-grade9-worksheets.json
