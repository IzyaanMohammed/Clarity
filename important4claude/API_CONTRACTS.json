{
    "base": "/api/v1",
    "auth": {
        "POST /auth/register": {
            "request": {
                "profile": "AuthProfile",
                "password": "string"
            },
            "response": {
                "token": "string",
                "user": "AuthUser"
            }
        },
        "POST /auth/login": {
            "request": {
                "name": "string",
                "password": "string"
            },
            "response": {
                "token": "string",
                "user": "AuthUser"
            }
        },
        "GET /auth/curriculum": {
            "response": {
                "catalog": "Record<class, Record<subject, string[]>>"
            }
        }
    },
    "practice": {
        "POST /practice/generate": {
            "request": {
                "class_num": "string",
                "subject": "string",
                "chapter": "string",
                "question_type": "string",
                "num_questions": "number"
            },
            "response": {
                "questions": [
                    "string"
                ]
            }
        },
        "POST /practice/grade": {
            "request": {
                "question": "string",
                "user_answer": "string",
                "class_num": "string",
                "subject": "string",
                "marks_available": "number"
            },
            "response": {
                "marks_awarded": "number",
                "total_marks": "number",
                "feedback": "string",
                "model_answer": "string"
            }
        }
    },
    "progress": {
        "POST /progress/log": {
            "auth": "Bearer token required",
            "request": {
                "action": "string",
                "subject": "string",
                "chapter": "string",
                "score": "number?"
            },
            "response": {
                "status": "Logged successfully"
            }
        },
        "GET /progress/stats/{user_id}": {
            "auth": "Bearer token + user match",
            "response": {
                "total_questions": "number",
                "questions_today": "number",
                "subjects_studied": [
                    "string"
                ],
                "weak_topics": [
                    "string"
                ],
                "streak_days": "number",
                "recent_activity": [
                    "object"
                ]
            }
        }
    },
    "creative": {
        "POST /creative/video-file": {
            "auth": "Bearer token required",
            "request": {
                "class_num": "string",
                "subject": "string",
                "chapter": "string",
                "topic": "string",
                "duration_seconds": "number",
                "style": "string",
                "broll_mode": "minimal|balanced|aggressive",
                "montage_level": "single|light|dynamic",
                "min_external_segments": "number"
            },
            "response": "video/mp4 blob",
            "headers": {
                "X-External-Video-Count": "number",
                "X-Procedural-Broll-Count": "number",
                "X-Montage-Segments": "number",
                "X-Broll-Mode": "string",
                "X-Montage-Level": "string"
            }
        },
        "POST /creative/mindmap-image": {
            "request": {
                "class_num": "string",
                "subject": "string",
                "chapter": "string",
                "topic": "string"
            },
            "response": {
                "image_url": "string",
                "notebook_blocks": [
                    "object"
                ]
            }
        }
    },
    "notes": [
        "Frontend should default to /api/v1 in dev and rely on Vite proxy.",
        "If telemetry counts stay zero repeatedly, inspect backend manifest writing + active runtime process.",
        "Global exception handling should not convert server errors into HTTP 200 in production."
    ]
}